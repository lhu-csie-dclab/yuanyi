# Build binaries
*.exe
*.exe.stackdump
/go-p2p
/client
/server

# Keys and credentials (do not commit)
identity.key
swarm.key
.env

# Runtime databases, logs, and statistics
stats.json
*.log
peers.db*
# GPU specification dataset, downloaded at runtime by scanGPUlevel.go (hub mode only).
# Not committed: upstream (voidful/gpu-info-api) declares no license, so shipping a
# copy would constitute redistribution. See NOTICE entry 30.
gpu_database.json
my-peerstore/

# IDE & OS files
.DS_Store
.idea/
.vscode/
*.swp

# web-ui (Vue + Vite + Tailwind dashboard) build artifacts -- built fresh by
# the Dockerfile's Node stage / CI, never committed. go:embed requires
# web-ui/dist to exist locally before `go build`; run `npm run build` inside
# web-ui/ first when building outside Docker.
web-ui/node_modules/
web-ui/dist/
